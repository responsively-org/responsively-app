{
	"name": "Responsively-Helper",
	"version": "1.0.0",
	"description": "An extension to open current browser page in Responsively app",
	"private": true,
	"scripts": {
		"start": "webpack --mode=development --watch",
		"build": "webpack --mode=production",
		"lint": "web-ext lint --source-dir=dist",
		"package": "web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts --overwrite-dest --ignore-files '*.map'",
		"release": "npm run build && npm run lint && npm run package"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/preset-env": "^7.29.7",
		"@babel/preset-react": "^7.29.7",
		"babel-loader": "^9.2.1",
		"copy-webpack-plugin": "^14.0.0",
		"web-ext": "^10.7.0",
		"webpack": "^5.111.1",
		"webpack-cli": "^5.1.4"
	},
	"dependencies": {
		"custom-protocol-check": "^1.4.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"webextension-polyfill": "^0.12.0"
	}
}
