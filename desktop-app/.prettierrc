{
  "overrides": [
    {
      "files": [
        ".prettierrc",
        ".babelrc",
        ".eslintrc",
        ".stylelintrc"
      ],
      "options": {
        "parser": "json"
      }
    }
  ],
  "arrowParens": "always",
  "singleQuote": true,
  "bracketSpacing": false,
  "printWidth": 100,
  "tailwindStylesheet": "./src/renderer/App.css",
  "trailingComma": "es5",
  "plugins": [
    "prettier-plugin-tailwindcss"
  ]
}